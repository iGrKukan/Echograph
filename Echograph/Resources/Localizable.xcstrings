    "Add Custom Vocabulary…": {
      "comment": "A label for a button that adds custom vocabulary to a transcription.",
      "isCommentAutoGenerated": true
    },
    "Add proper nouns, technical terms, brand names you want the transcript to get right. One per line works best.": {
      "comment": "A description of the vocabulary input field.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Eigennamen, Fachbegriffe und Markennamen hinzu, die im Transkript richtig erkannt werden sollen. Am besten einen pro Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add proper nouns, technical terms, brand names you want the transcript to get right. One per line works best."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les noms propres, termes techniques et noms de marque que vous voulez voir correctement reconnus. Un par ligne, idéalement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしで正しく認識してほしい固有名詞、専門用語、ブランド名を追加してください。1行に1つずつが最適です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте имена собственные, технические термины и названия брендов, которые должны распознаваться верно. Лучше по одному на строку."
          }
        }
      }
    },
