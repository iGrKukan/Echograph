    "Pro-quality on-device transcription with AI summary and Q&A. Everything stays on your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-quality on-device transcription with AI summary and Q&A. Everything stays on your iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профессиональная расшифровка прямо на устройстве, с ИИ-конспектом и вопросами к записи. Всё остаётся на вашем iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstklassige Transkription direkt auf dem Gerät, mit KI-Zusammenfassung und Rückfragen. Alles bleibt auf Ihrem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription professionnelle sur l'appareil, avec résumé IA et questions-réponses. Tout reste sur votre iPhone."
          }
        },
        "ja": {
          "stringUnit": {
