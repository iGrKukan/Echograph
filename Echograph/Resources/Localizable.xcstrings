    "Tap the record button to capture your first voice note. Audio stays on your device." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the record button to capture your first voice note. Audio stays on your device." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Нажмите красную кнопку, чтобы сделать первую запись. Аудио не покидает устройство." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tippe auf den Aufnahme-Button, um deine erste Sprachnotiz zu erstellen. Audio bleibt auf deinem Gerät." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appuyez sur le bouton d'enregistrement pour capturer votre première note vocale. L'audio reste sur votre appareil." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "録音ボタンをタップして、最初のボイスメモを作成します。音声はデバイスに保存されます。" } }
