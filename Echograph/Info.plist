	<string>1</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Voicekeep creates calendar events from recordings only when you tap Add to Calendar.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Voicekeep creates calendar events from recordings only when you tap Add to Calendar.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voicekeep records your voice locally — audio never leaves your device.</string>
