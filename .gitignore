# Xcode — keep .xcodeproj checked in (TimberBid-style workflow), drop only
# the per-user state so two Macs don't fight over breakpoints / window layout.
build/
DerivedData/
xcuserdata/
*.xcuserstate
project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm/

# macOS
.DS_Store

# Generated
*.hmap
*.ipa

# Models (Whisper weights — should be downloaded at runtime)
Models/
*.mlmodelc
*.mlmodel

# Local config
*.local.xcconfig

# Secrets — never commit
fastlane/secrets/
fastlane/report.xml
fastlane/.env*
*.p8

# Python venv & cache
fastlane/.venv/
fastlane/__pycache__/
**/__pycache__/

# Build artifacts
build/
private_keys/
