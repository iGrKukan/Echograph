# Xcode — keep .xcodeproj checked in (TimberBid-style workflow), drop only
# the per-user state so two Macs don't fight over breakpoints / window layout.
build/
DerivedData/
xcuserdata/
*.xcuserstate
project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm/

# macOS
.DS_Store

# Generated
*.hmap
*.ipa

# Whisper weights / CoreML compiled models — never bundle, downloaded at runtime
*.mlmodelc
*.mlmodel
# (Earlier this section had `Models/` which silently ate Echograph/Core/Models/.
# DO NOT add bare directory names here — they match anywhere in the tree.)

# Local config
*.local.xcconfig

# Secrets — never commit
fastlane/secrets/
fastlane/report.xml
fastlane/.env*
*.p8

# Python venv & cache
fastlane/.venv/
fastlane/__pycache__/
**/__pycache__/

# Build artifacts
build/
private_keys/
